{
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval' https://www.googletagmanager.com; object-src 'none'; base-uri 'self';"
        }
      ]
    }
  ]
}
